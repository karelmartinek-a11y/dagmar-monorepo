[Unit]
Description=Renew all Dagmar production TLS certificates
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/letsencrypt/wedos-wapi.env

[Service]
Type=oneshot
ExecStart=/usr/bin/test -r /etc/letsencrypt/wedos-wapi.env
ExecStart=/bin/sh -c 'test "$(stat -c %%a /etc/letsencrypt/wedos-wapi.env)" = 600'
ExecStart=/usr/bin/certbot renew --non-interactive --quiet
StandardOutput=journal
StandardError=journal
