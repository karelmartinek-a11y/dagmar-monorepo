{
  "name": "kajovodagmar-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:branding && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check:branding": "node scripts/check-branding.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:cml-periods": "node scripts/cml-periods.browser.mjs",
    "test:cml-downloads": "node scripts/cml-downloads.browser.mjs",
    "test:cml-prints": "node scripts/cml-prints.browser.mjs",
    "test:cml-admin-info": "node scripts/cml-admin-info.browser.mjs",
    "test:cml-clock": "node scripts/cml-clock.browser.mjs",
    "test:cml-print-backend": "node scripts/cml-print-backend.browser.mjs",
    "test:cml-languages": "node scripts/cml-languages.browser.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "i18next": "^27.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
